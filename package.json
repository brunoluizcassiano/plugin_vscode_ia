{
    "name": "f1rst-vscode-extension",
    "publisher": "f1rst",
    "displayName": "VS Code quality plugin for Jira and Zephyr",
    "description": "Integra o VS Code ao Jira e Zephyr: painel com autocomplete de issues (Functionality/Epic/Story), detalhes e comentários no Jira, criação/atualização de testes no Zephyr e análises QA via GitHub Copilot.",
    "version": "1.1.0",
    "engines": {
        "vscode": "^1.95.0"
    },
    "main": "./out/extension.js",
        "activationEvents": [
            "*",
            "onView:homeView",
            "onView:qualityArtifactsView",
            "onView:qualityTestsView",
            "onView:qualityProjectStatusView"
        ],
    "contributes": {
        "configuration": {
            "title": "Plugin COE PLARD",
            "properties": {
                "plugin.jira.domain": {
                    "type": "string",
                    "default": "",
                    "description": "Domínio do Jira (ex.: org.atlassian.net)"
                },
                "plugin.jira.email": {
                    "type": "string",
                    "default": "",
                    "description": "E-mail do Jira"
                },
                "plugin.jira.token": {
                    "type": "string",
                    "default": "",
                    "description": "Token do Jira (texto plano)"
                },
                "plugin.jira.projectCategoryId": {
                    "type": "string",
                    "default": "",
                    "description": "Category ID para filtrar projetos do Jira. Deixe vazio para listar todos os projetos."
                },
                "plugin.ai.provider": {
                    "type": "string",
                    "default": "auto",
                    "description": "Vendor/provider de IA selecionado a partir dos modelos disponíveis via vscode.lm."
                },
                "plugin.ai.vendor": {
                    "type": "string",
                    "default": "",
                    "description": "Vendor customizado para busca de modelos via vscode.lm, quando provider=custom ou auto."
                },
                "plugin.ai.modelFamily": {
                    "type": "string",
                    "default": "",
                    "description": "Family/modelo preferido para busca via vscode.lm. Deixe vazio para usar o primeiro modelo disponível do provider."
                },
                "plugin.ai.devinOrgSlug": {
                    "type": "string",
                    "default": "",
                    "description": "Slug da organização no Devin Enterprise. Ex.: sei-software-engineering-intelligence"
                },
                "plugin.ai.devinApiKey": {
                    "type": "string",
                    "default": "",
                    "description": "API Key do Devin Enterprise (começa com apk_user_). Gere em Settings -> API Keys."
                },
                "plugin.zephyr.ownerId": {
                    "type": "string",
                    "default": "",
                    "description": "Owner ID do Zephyr Scale"
                },
                "plugin.zephyr.domain": {
                    "type": "string",
                    "default": "",
                    "description": "Domínio do Zephyr Scale"
                },
                "plugin.zephyr.token": {
                    "type": "string",
                    "default": "",
                    "description": "Token do Zephyr Scale (texto plano)"
                },
                "plugin.projectMap": {
                    "type": "object",
                    "default": {},
                    "description": "Jira -> Zephyr (ex.: { \"TBTX\": \"SQTC\" })"
                },
                "plugin.projectMap.strict": {
                    "type": "boolean",
                    "default": false,
                    "description": "Exigir de/para para todos os projetos"
                },
                "plugin.openOnStart": {
                    "type": "boolean",
                    "default": false,
                    "description": "Se true, a view do plugin será aberta/focada automaticamente quando o VS Code iniciar. Desative para evitar que o plugin pule ao abrir o editor."
                }
            }
        },
        "commands": [
            {
                "command": "plugin-vscode.openJira",
                "title": "Abrir Jira"
            },
            {
                "command": "plugin-vscode.getJiraUser",
                "title": "Obter usuário Jira"
            },
            {
                "command": "plugin-vscode.openZephyr",
                "title": "Abrir Zephyr"
            },
            {
                "command": "plugin-vscode.backend",
                "title": "Abrir Backend"
            },
            {
                "command": "plugin-vscode.openWebFlow",
                "title": "Abrir Automação Web"
            },
            {
                "command": "plugin-vscode.settings",
                "title": "Abrir configurações"
            },
            {
                "command": "plugin-vscode.refreshGitHubSession",
                "title": "Entrar no GitHub"
            },
            {
                "command": "plugin-vscode.refreshArtifacts",
                "title": "Atualizar artefatos"
            },
            {
                "command": "plugin-vscode.refreshTests",
                "title": "Atualizar testes"
            },
            {
                "command": "plugin-vscode.cypressOpen",
                "title": "Cypress Open",
                "icon": "$(beaker)"
            },
            {
                "command": "plugin-vscode.cypressRun",
                "title": "Cypress Run",
                "icon": "$(play)"
            },
            {
                "command": "plugin-vscode.refreshProjectStatus",
                "title": "Atualizar projeto"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "formSidebar",
                    "title": "QE Studio",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "formSidebar": [
                {
                    "id": "homeView",
                    "name": "Início"
                },
                {
                    "id": "qualityArtifactsView",
                    "name": "Artefatos"
                },
                {
                    "id": "qualityTestsView",
                    "name": "Testes"
                },
                {
                    "id": "qualityProjectStatusView",
                    "name": "Projeto"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "plugin-vscode.refreshArtifacts",
                    "when": "view == qualityArtifactsView",
                    "group": "navigation"
                },
                {
                    "command": "plugin-vscode.cypressOpen",
                    "when": "view == qualityTestsView",
                    "group": "navigation@1"
                },
                {
                    "command": "plugin-vscode.cypressRun",
                    "when": "view == qualityTestsView",
                    "group": "navigation@2"
                },
                {
                    "command": "plugin-vscode.refreshTests",
                    "when": "view == qualityTestsView",
                    "group": "navigation@3"
                },
                {
                    "command": "plugin-vscode.refreshProjectStatus",
                    "when": "view == qualityProjectStatusView",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "tsc -p ./",
        "package": "vsce package"
    },
    "dependencies": {
        "js-beautify": "^1.15.4",
        "js-yaml": "^4.1.0",
        "node-fetch": "^2.7.0"
    },
    "devDependencies": {
        "@types/js-beautify": "^1.14.3",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^24.3.0",
        "@types/node-fetch": "^2.6.12",
        "@types/vscode": "^1.70.0",
        "typescript": "^4.7.4",
        "vsce": "^2.15.0"
    }
}
